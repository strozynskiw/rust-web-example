# Run from the repository root. SQLite file and migrations are created on startup.
DATABASE_URL=sqlite:./data.db
HOST=127.0.0.1
PORT=3000
# Exact browser origin, without a trailing slash. HTTPS enables Secure cookies.
APP_ORIGIN=http://localhost:3000
RUST_LOG=web_template=info,tower_http=info

# Optional local PostgreSQL: choose a unique password, then docker compose up -d postgres.
# POSTGRES_PASSWORD=
# DATABASE_URL=postgresql://web-template:YOUR_URL_ENCODED_PASSWORD@localhost:5432/web-template
